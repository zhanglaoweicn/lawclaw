# ── LawClaw 同步安全网追加（2026-09-11）──
# 密钥与环境（绝不入库）
backend/.env
.env
*.env.local
# 运行时数据（.hermes 含 sessions/state.db/auth）
# 注意：只忽略 .hermes 的**内容**，以便单独放行 build 输入（技能库 + 启用白名单）——
# 否则从仓库全新克隆后打出的包会没有任何法律技能（发布不可复现）。
backend/.hermes/*
!backend/.hermes/skills/
!backend/.hermes/config.yaml
# 技能库内的运行期缓存/日志仍不进库
backend/.hermes/skills/**/__pycache__/
backend/.hermes/skills/**/*.pyc
